# ── Supabase ─────────────────────────────────
# Get these from https://supabase.com/dashboard > Project > Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# ⚠️  SECURITY: The service role key bypasses all Row Level Security and has unrestricted
# database access. Treat it like a root password. Never commit to version control.
# Consider using the anon key if you only need read access with RLS policies enabled.
SUPABASE_KEY=eyJhbGciOi...your-service-role-key

# ── Proxy ───────────────────────────────────
# Optional: datacenter proxy (http://user:pass@host:port)
PROXY_LIST=

# ── Playwright / Browser ────────────────────
# Run headless (true) or with visible browser (false)
HEADLESS=true
# Human-like scroll/delay + canvas/WebGL spoofing
PLAYWRIGHT_HUMAN_SIMULATION=true
# Persist browser cookies between runs
COOKIE_PERSIST_ENABLED=true

# ── LLM fallback extraction ────────────────
# Required if LLM fallback is enabled (enabled by default)
OPENAI_API_KEY=sk-...
LLM_ENABLED=true
LLM_MODEL=gpt-4o-mini
LLM_CACHE_TTL=86400
LLM_CACHE_PATH=llm_cache.db

# ── curl-cffi anti-bot layer ────────────────
CURL_CFFI_ENABLED=true
CURL_CFFI_IMPERSONATE=chrome124

# ── Email alerts ────────────────────────────
# Gmail SMTP (use App Password, not account password)
# Get App Password: https://myaccount.google.com/apppasswords
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_EMAIL_FROM=scrapper@gmail.com
ALERT_EMAIL_PASSWORD=abcd efgh ijkl mnop
ALERT_EMAIL_TO=tu@email.com
ALERT_ERROR_THRESHOLD=5

# ── Scrapyd (optional) ──────────────────────
SCRAPYD_API_URL=http://localhost:6800/schedule.json

# ── Scheduling ──────────────────────────────
SCHEDULE_ENABLED=false

# ── RAG export ──────────────────────────────
RAG_EXPORT_ENABLED=true

# ── Logging ──────────────────────────────────
LOG_LEVEL=INFO

# ── AI Alert Webhook (Discord/Slack) ────────
# Optional webhook URL for error alert notifications
ALERT_WEBHOOK_URL=
