# Supabase — get these from https://supabase.com/dashboard > Project > Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOi...your-service-role-key

# Optional: datacenter proxy (http://user:pass@host:port)
PROXY_LIST=

# Email alerts — Gmail SMTP (use App Password, not account password)
# Get App Password: https://myaccount.google.com/apppasswords
ALERT_EMAIL_FROM=scrapper@gmail.com
ALERT_EMAIL_PASSWORD=abcd efgh ijkl mnop
ALERT_EMAIL_TO=tu@email.com
ALERT_ERROR_THRESHOLD=5

# Scheduling (enable in production with SCHEDULE_ENABLED=true)
SCHEDULE_ENABLED=false
REDDIT_QUERY=python
REDDIT_LIMIT=10
HOTMART_QUERY=marketing
HOTMART_LIMIT=10