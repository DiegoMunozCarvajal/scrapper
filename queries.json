{
  "reddit": {
    "schedule": "*/30 * * * *",
    "cloud_run": {
      "cpu": 1,
      "memory": "1Gi",
      "timeout": "30m"
    },
    "queries": [
      { "subreddit": "seduction", "limit": 50 },
      { "subreddit": "PickUpArtist", "limit": 50 },
      { "subreddit": "dating_advice", "limit": 50 },
      { "subreddit": "dating", "limit": 50 },
      { "subreddit": "Flirting", "limit": 50 },
      { "subreddit": "socialskills", "limit": 50 },
      { "subreddit": "OnlineDating", "limit": 50 },
      { "subreddit": "AskMenAdvice", "limit": 50 },
      { "subreddit": "AskWomen", "limit": 50 },
      { "subreddit": "AskWomenNoCensor", "limit": 50 },
      { "subreddit": "askwomenadvice", "limit": 50 },
      { "subreddit": "datingoverthirty", "limit": 50 },
      { "subreddit": "Bumble", "limit": 50 },
      { "subreddit": "Tinder", "limit": 50 },
      { "subreddit": "hingeapp", "limit": 50 },
      { "subreddit": "OkCupid", "limit": 50 }
    ]
  },
  "hotmart": {
    "schedule": "0 8,20 * * *",
    "cloud_run": {
      "cpu": 1,
      "memory": "2Gi",
      "timeout": "20m"
    },
    "queries": [
      { "query": "marketing", "limit": 5 },
      { "query": "desarrollo web", "limit": 5 }
    ]
  },
  "generic": {
    "schedule": "0 */6 * * *",
    "cloud_run": {
      "cpu": 1,
      "memory": "1Gi",
      "timeout": "20m"
    },
    "queries": [
      { "url": "https://books.toscrape.com", "type": "listing" }
    ]
  }
}
